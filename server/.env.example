NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sap_ams
DB_USER=postgres
DB_PASSWORD=change-me

# Generate a unique value for each environment; never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760

GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional SMTP settings for chat email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
